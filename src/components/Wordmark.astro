---
/**
 * cnsqdesigns — brand wordmark
 * =====================================================================
 * ARCHITECTURAL DECISIONS
 * ---------------------------------------------------------------------
 * 1. The mark is the brand's double-chevron PNG supplied by the owner
 *    (src/assets/brand/cnsqdesigns-mark.png, 40x40), rendered with
 *    astro:assets <Image> so Astro emits a hashed file plus explicit
 *    width/height (no layout shift). The same file is copied to
 *    public/cnsqdesigns-mark.png for reference; the tab favicon stays
 *    vector (public/favicon.svg) because SVG is sharper in tabs than a
 *    40px raster.
 * 2. The wordmark is real text, not artwork. It stays selectable,
 *    translatable, searchable and reflowable, and screen readers get the
 *    brand name from the link's `aria-label`. The image itself has an
 *    empty alt and is aria-hidden so the name is announced once.
 * 3. NAMING GUARDRAIL — `text-transform: lowercase` is applied in CSS so
 *    the brand can never render as "CnsqDesigns" / "CNSQDESIGNS" even if
 *    someone types it that way in content. The brand is always
 *    lowercase: cnsqdesigns.
 */

import { Image } from 'astro:assets';

import { BRAND_SLUG } from '@/data/site';
import mark from '@/assets/brand/cnsqdesigns-mark.png';

export interface Props {
  /** `sm` for the footer, `md` for the sticky header. */
  readonly size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;
---

<a class:list={['cnsq-wordmark', `cnsq-wordmark--${size}`]} href="/" aria-label={`${BRAND_SLUG} — back to top`}>
  <Image
    class="cnsq-wordmark__mark"
    src={mark}
    alt=""
    aria-hidden="true"
    width={size === 'sm' ? 26 : 40}
    height={size === 'sm' ? 26 : 40}
    loading="eager"
    decoding="async"
  />
  <span class="cnsq-wordmark__text">{BRAND_SLUG}</span>
</a>

<style lang="scss">
  @use 'abstracts/mixins' as mix;
  @use 'abstracts/tokens' as t;

  .cnsq-wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--csq-space-2xs);
    color: var(--csq-paper);

    @include mix.focus-ring;

    // Enforces the lowercase brand convention at the presentation layer.
    &__text {
      font-family: var(--csq-font-display, #{t.$csq-font-display});
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1;
      text-transform: lowercase;
    }

    &__mark {
      // Owner-supplied PNG: keep intrinsic pixels, no colour override.
      flex: none;
      border-radius: 0.375rem;
    }

    &--sm &__text {
      font-size: var(--csq-step-1);
    }

    &--md &__text {
      font-size: var(--csq-step-2);
    }

    &--sm &__mark {
      inline-size: 1.625rem;
      block-size: 1.625rem;
    }

    &--md &__mark {
      inline-size: 2.5rem;
      block-size: 2.5rem;
    }
  }
</style>