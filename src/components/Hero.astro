---
/**
 * cnsqdesigns — hero
 * =====================================================================
 * ARCHITECTURAL DECISIONS
 * ---------------------------------------------------------------------
 * 1. The hero artwork is the Canva demo site brand mark
 *    (media/36d54cdbe2be5535f5050d60e0581b1f.png, 700x300) ingested as
 *    src/assets/brand/cnsqdesigns-hero-mark.png. It is rendered with
 *    <Picture> eager + fetchpriority="high": it shares the first viewport
 *    with the <h1>, so it is part of the LCP and must not be lazy. The
 *    source is only ~196 KB and Astro emits smaller AVIF/WebP variants,
 *    so the LCP cost stays inside budget — unlike a hero photograph.
 * 2. Layout is two-column on desktop (copy left, mark right) collapsing
 *    to stacked on mobile with the mark first, so the brand reads before
 *    the headline on a phone. The ambient hatch + specimen grid remain as
 *    the zero-byte backdrop.
 * 3. Entrance animation is CSS-only and stagger-scheduled with inline
 *    `--cnsq-delay` custom properties. No animation library, no client JS,
 *    and `prefers-reduced-motion` users see the final layout immediately.
 *    The <h1> uses the transform-only `.cnsq-lift` variant so the LCP
 *    element is opaque in the first frame (see the note in _motion.scss).
 * 4. One <h1> per page: the hero owns it, sections use <h2>.
 * 5. The facts row is a full-width strip BELOW the two-column grid, so
 *    its hairline rule spans the entire shell — copy column plus image
 *    column — ending flush with the brand mark's right edge. It is a
 *    sibling of the grid, not a child of the copy column, which is what
 *    makes the full-bleed rule possible. On mobile it stays full-width
 *    under the stacked image + copy.
 * 6. CTA anchors are plain `href="#id"` links. Smooth scrolling and the
 *    sticky-header offset are handled in CSS (see _reset.scss), so the
 *    navigation works identically with JavaScript disabled.
 */

import { Picture } from 'astro:assets';

import { HERO } from '@/data/site';
import { requireAsset } from '@/lib/assets';

const heroMark = requireAsset('cnsqdesigns-hero-mark');
---

<section class="cnsq-hero" aria-labelledby="hero-heading">
  <div class="cnsq-hero__inner">
    <figure class="cnsq-hero__figure cnsq-rise" style="--cnsq-delay: 0ms">
      <Picture
        src={heroMark}
        formats={['avif', 'webp']}
        fallbackFormat="png"
        widths={[360, 560, 700]}
        sizes="(min-width: 64rem) 36vw, 84vw"
        alt="cnsqdesigns brand mark artwork from the Canva demo site"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <div class="cnsq-hero__copy">
      <p class="cnsq-eyebrow cnsq-hero__eyebrow cnsq-rise" style="--cnsq-delay: 60ms">
        {HERO.eyebrow}
      </p>

      <h1 id="hero-heading" class="cnsq-hero__title cnsq-lift" style="--cnsq-delay: 0ms">
        {HERO.headline}
      </h1>

      <p class="cnsq-hero__standfirst cnsq-rise" style="--cnsq-delay: 180ms">
        {HERO.standfirst}
      </p>

      <div class="cnsq-button-group cnsq-hero__actions cnsq-rise" style="--cnsq-delay: 260ms">
        <a class="cnsq-button cnsq-button--solid" href={`#${HERO.primaryCta.id}`}>
          {HERO.primaryCta.label}
        </a>
        <a class="cnsq-button cnsq-button--ghost" href={`#${HERO.secondaryCta.id}`}>
          {HERO.secondaryCta.label}
        </a>
      </div>
    </div>

    <dl class="cnsq-hero__facts cnsq-reveal">
      {
        HERO.facts.map((fact) => (
          <div class="cnsq-hero__fact">
            <dt class="cnsq-hero__fact-term">{fact.term}</dt>
            <dd class="cnsq-hero__fact-detail">{fact.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="cnsq-hero__grid" aria-hidden="true"></div>
</section>

<style lang="scss">
  @use 'abstracts/mixins' as mix;
  @use 'abstracts/tokens' as t;

  .cnsq-hero {
    position: relative;
    overflow: hidden;
    display: grid;
    // Bottom-aligned content inside a full-height block: the headline sits
    // low on the page, which is what gives the opening screen its
    // editorial weight instead of the usual centred splash.
    align-content: end;
    min-block-size: calc(100svh - var(--csq-header-block));
    padding-block: clamp(var(--csq-space-2xl), 14vh, var(--csq-space-3xl)) var(--csq-space-xl);
    border-block-end: 1px solid var(--csq-line);

    &__inner {
      @include mix.shell;

      position: relative;
      z-index: 2; // above the decorative specimen grid
      display: grid;
      gap: var(--csq-space-lg) var(--csq-space-2xl);
      max-inline-size: none;
      align-items: center;
    }

    // Brand mark figure. Zero margin (figure reset lives in _reset, but
    // this keeps the hero self-sufficient), art-directed per breakpoint.
    &__figure {
      margin: 0;
      max-inline-size: 34rem;
    }

    &__figure img {
      inline-size: 100%;
      block-size: auto;
      border-radius: var(--csq-radius-md);
    }

    // Copy block: centred text. The facts strip below is a sibling grid,
    // so centring here affects only the eyebrow/headline/standfirst/CTAs.
    &__copy {
      display: grid;
      gap: var(--csq-space-md);
      max-inline-size: none;
      justify-items: center;
      text-align: center;
    }

    &__title {
      margin-inline: auto;
    }

    &__standfirst {
      @include mix.lead;

      margin-inline: auto;
    }

    &__actions {
      margin-block-start: var(--csq-space-2xs);
      justify-content: center;
    }

    // Facts strip: full shell width (sibling of the two-column grid, so
    // the hairline runs copy edge to brand-mark edge), content centred.
    &__facts {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--csq-space-sm) var(--csq-space-lg);
      margin: var(--csq-space-xl) 0 0;
      padding-block-start: var(--csq-space-md);
      border-block-start: 1px solid var(--csq-line);
      text-align: center;
    }

    &__fact {
      display: grid;
      gap: var(--csq-space-3xs);
      min-inline-size: 8rem;
      justify-items: center;
    }

    &__eyebrow {
      margin: 0;
      justify-content: center;
    }

    &__title {
      font-size: var(--csq-step-6);
      line-height: 1.04;
      letter-spacing: 0;
      max-inline-size: 16ch;
      margin-block-start: var(--csq-space-2xs);
    }

    &__fact-term {
      @include mix.eyebrow;

      font-size: var(--csq-step--2);
      color: var(--csq-paper-faint);
    }

    &__fact-detail {
      margin: 0;
      font-size: var(--csq-step-0);
      color: var(--csq-paper);
    }

    // The specimen grid: 12 hairlines that fade out down the page. Pure
    // background-image, so it is free and cannot shift layout.
    &__grid {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      opacity: 0.6;
      background-image: repeating-linear-gradient(
        to right,
        var(--csq-line) 0 1px,
        transparent 1px calc(100% / 6)
      );
      mask-image: linear-gradient(to bottom, #000 0%, transparent 72%);

      @include mix.from('lg') {
        background-image: repeating-linear-gradient(
          to right,
          var(--csq-line) 0 1px,
          transparent 1px calc(100% / 12)
        );
      }
    }
  }

  // Desktop: copy left, brand mark right, facts strip full-width below.
  // The figure comes first in DOM order (brand reads first on mobile)
  // and is visually re-ordered here. The facts <dl> is a direct grid
  // child spanning all columns, so its hairline runs the full shell —
  // ending flush with the brand mark's right edge.
  @include mix.from('lg') {
    .cnsq-hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .cnsq-hero__figure {
      order: 2;
      max-inline-size: none;
    }

    .cnsq-hero__copy {
      order: 1;
    }

    .cnsq-hero__facts {
      grid-column: 1 / -1;
    }
  }
</style>