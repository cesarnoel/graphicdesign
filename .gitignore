# cnsqdesigns — ignore rules
# ---------------------------------------------------------------------
# Astro build output and cache
dist/
.astro/
node_modules/

# Canva download/scratch workspace (raw originals + bootstrap decodes).
# The ingested, resized sources live in src/assets/ — this folder is only
# needed to re-run scripts/ingest-canva-assets.mjs.
.work/

# Netlify local state
.netlify/

# Environment files — never commit secrets, even on a static site.
.env
.env.*
!.env.example

# Logs (including the detached install logs used during this scaffold)
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Astro's generated type declarations are produced by `astro sync`
.astro/types.d.ts